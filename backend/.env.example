# Copy this file to .env and fill in the values.

# development | production | test
NODE_ENV=development

# Port the API listens on
PORT=4000

# Website addresses allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:8443

# Where the SQLite database file is kept (created automatically)
DATABASE_PATH=./data/bushaashe.db

# Secret key for the staff endpoints that list messages and visit requests.
# Send it as:  Authorization: Bearer <ADMIN_API_KEY>
# Use a long random value (at least 24 characters). Leave empty to turn the staff endpoints off.
ADMIN_API_KEY=

# How many form submissions one visitor may send per 15 minutes
FORM_RATE_LIMIT=10

# ── Email ──────────────────────────────────────────────────────────────────
# The mail server that sends from info@bushaashegaruwa.com. Leave SMTP_HOST empty
# while developing: every email is then saved as an .html file in MAIL_OUTBOX.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Bushaashe Garuwa <info@bushaashegaruwa.com>

# Where staff are told about new bookings, visit requests and messages (empty to skip)
STAFF_EMAIL=

MAIL_OUTBOX=./data/outbox

# The public website, used for the logo and links inside the emails
SITE_URL=https://bushashe-garuwa.vercel.app

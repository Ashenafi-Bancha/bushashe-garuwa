{
  "name": "@bushaashe/frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "build:app": "tsc --noEmit -p . && vite build --mode app",
    "typecheck": "tsc --noEmit -p .",
    "preview": "vite preview",
    "format": "oxfmt",
    "photos": "python scripts/optimize-photos.py",
    "wolaytta": "node --experimental-strip-types --no-warnings scripts/wolaytta.mjs",
    "wolaytta:sync": "node --experimental-strip-types --no-warnings scripts/wolaytta.mjs sync",
    "video": "python scripts/optimize-video.py"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "motion": "^13.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}

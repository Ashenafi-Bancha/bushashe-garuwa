# Copy to .env.local and adjust.

# Address of the Bushaashe Garuwa API (backend/).
#  - while developing with `pnpm dev:all`: /api   (Vite forwards it to http://localhost:4000)
#  - in production: the public address of the API, e.g. https://api.bushaashegaruwa.com/api
# Leave empty and the forms only show the thank-you message without sending anything.
VITE_API_URL=

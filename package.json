{
  "name": "bushaashe-garuwa",
  "private": true,
  "version": "1.0.0",
  "description": "Bushaashe Garuwa: website (frontend) and API (backend)",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm --filter @bushaashe/frontend dev",
    "dev:api": "pnpm --filter @bushaashe/backend dev",
    "dev:all": "pnpm --parallel --filter \"./frontend\" --filter \"./backend\" dev",
    "build": "pnpm --filter @bushaashe/frontend build",
    "build:api": "pnpm --filter @bushaashe/backend build",
    "start:api": "pnpm --filter @bushaashe/backend start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @bushaashe/backend test",
    "photos": "pnpm --filter @bushaashe/frontend photos",
    "format": "pnpm --filter @bushaashe/frontend format",
    "video": "pnpm --filter @bushaashe/frontend video"
  }
}
